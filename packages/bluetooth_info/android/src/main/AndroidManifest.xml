<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 11 ve altı -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Android 12+ : adaptör adı, adresi ve eşleşmiş cihazlar için -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Android 12+ : yakındaki cihazları taramak için -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <!-- Android 11 ve altında tarama konum izni ister -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- Bluetooth donanımı olmayan cihazlarda da uygulama kurulabilsin -->
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />
</manifest>
